--- import Layout from '../layouts/Layout.astro'; const shows=[['money-desk','The Money Desk','Money decisions for a changing Mzansi.'],['township-ceo','Township CEO','Practical enterprise without the hype.'],['african-archives','African Archives','The history behind the headlines.'],['mind-decoded','Mind Decoded','Tools for clearer thinking and better living.']]; ---
<Layout><main><header><span class="eyebrow">JABULANIFM / CONTENT OS</span><h1>South African ideas,<br/><em>broadcast differently.</em></h1><p class="lede">Ten specialist shows covering money, work, culture, history and health — made for the way Mzansi actually lives.</p><a class="button" href="#shows">Explore the network ↓</a></header><section id="shows"><div class="section-head"><span class="eyebrow">THE NETWORK</span><h2>Pick your signal.</h2></div><div class="grid">{shows.map(([slug,name,desc])=><a class="card" href={`/shows/${slug}`}><span class="number">0{shows.indexOf([slug,name,desc])+1}</span><h3>{name}</h3><p>{desc}</p><span class="arrow">↗</span></a>)}</div></section></main></Layout>
<style> :global(*){box-sizing:border-box}:global(body){margin:0;background:#0A0B0E;color:#F9FAFB;font-family:Inter,system-ui,sans-serif}:global(a){color:inherit;text-decoration:none}main{max-width:1180px;margin:auto;padding:32px 6vw 100px}header{padding:13vh 0 16vh;border-bottom:1px solid #292d39;max-width:900px}.eyebrow{color:#F59E0B;font:600 12px/1.2 monospace;letter-spacing:.16em}h1{font-size:clamp(3.5rem,9vw,8.5rem);line-height:.9;letter-spacing:-.07em;margin:24px 0}h1 em{color:#F59E0B;font-style:normal}.lede{max-width:570px;color:#9CA3AF;font-size:1.15rem;line-height:1.6}.button{display:inline-block;margin-top:28px;background:#F59E0B;color:#0A0B0E;padding:15px 22px;font-weight:800}.section-head{padding:80px 0 28px}h2{font-size:clamp(2.5rem,6vw,5rem);letter-spacing:-.06em;margin:12px 0}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px}.card{position:relative;min-height:230px;background:#141722;padding:24px;border:1px solid #292d39;transition:transform .2s,border-color .2s}.card:hover{transform:translateY(-4px);border-color:#F59E0B}.card h3{font-size:1.5rem;margin-top:70px}.card p{color:#9CA3AF;line-height:1.5}.number{color:#EF4444;font:12px monospace}.arrow{position:absolute;right:22px;top:20px;color:#F59E0B;font-size:1.5rem}</style>
