---
import Layout from '../layouts/Layout.astro'; import HeroProgramGuide from '../components/HeroProgramGuide.jsx'; import ShowShelfGrid from '../components/ShowShelfGrid.jsx'; import {shows} from '../data/shows';
---
<Layout><main><HeroProgramGuide client:load shows={shows}/><section id="shows" class="section"><div class="section-head"><span class="eyebrow">THE NETWORK</span><h2>Pick your signal.</h2><p>Ten focused formats. One South African point of view.</p></div><ShowShelfGrid client:load shows={shows}/></section><section class="manifesto"><span class="eyebrow">WHY JABULANIFM</span><h2>Useful ideas for<br/><em>real life.</em></h2><p>We turn the noise into practical intelligence — made for the way Mzansi actually lives, works and builds.</p></section></main></Layout>
